# ------------------------------------------------------------------
# Copy this file to ".env.local" and fill in your own values.
# Never commit ".env.local" to git — it holds your secret keys.
# ------------------------------------------------------------------

# Supabase project settings (Project Settings > API in your Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Service role key — SECRET. Used only in server-side API routes.
# NEVER expose this to the browser / never prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Used to sign login session cookies (JWT). Make this a long random string.
# You can generate one with: openssl rand -base64 48
SESSION_SECRET=replace-this-with-a-long-random-string

# Simple admin login for the /admin panel
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password

# Name of the Supabase Storage bucket used for chat file uploads
NEXT_PUBLIC_STORAGE_BUCKET=chat-files
